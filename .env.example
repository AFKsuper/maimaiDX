# maimaidx
MAIMAIDX_PATH=
MAIMAIDX_ALIAS_PROXY=false
SAVE_IN_MEMORY=true
ASSETS_ONLINE=true

# diving-fish
DIVINGFISH_TOKEN=
DIVINGFISH_PROBER_PROXY=false
# 成绩上传的 OAuth 复用 dfbind 授权，需填写水鱼应用凭据（开放平台应用）
DIVINGFISH_CLIENT_ID=
DIVINGFISH_CLIENT_SECRET=

# lxns
LXNS_DEV_TOKEN=
LX_CLIENT_ID=
LX_CLIENT_SECRET=
REDIRECT_URI=

# 成绩上传（可选）
# MAI_HTTP_PROXY=http://127.0.0.1:7890   拉取/上传成绩走的 HTTP 代理，直连可留空
# DIVINGFISH_SCOPE="profile prober.profile.read" "prober.records.read" "chunithm.records.read" "chunithm.records.write" "prober.records.write"
#   每个权限用双引号括起，权限之间用空格隔开（插件已兼容该写法；python-dotenv 原本无法解析多引号段，已在 config.py 里做了归一化）
#   成绩上传需要 DIVINGFISH_SCOPE 包含 prober.records.write（写入权限需水鱼应用过审）；
#   修改 scope 后需重新发送 dfbind 重授权才会生效